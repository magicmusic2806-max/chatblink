{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatblink",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/index.html",
      "/rooms",
      "/dms",
      "/explore",
      "/room/*",
      "/profile/*",
      "/api/*",
      "/auth/*",
      "/enter",
      "/uploads/*"
    ]
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "ChatHub" }]
  },
  // The apex and www (which worker/index.js redirects to the apex) are declared as Worker custom
  // domains, so `wrangler deploy` keeps the live domains attached instead of that living only in the
  // dashboard. Each custom domain brings its own DNS record and certificate, and needs the zone to be
  // active in this account with no conflicting record on the name, or the deploy fails.
  // There is deliberately no `chatblink.chat/*` zone route alongside them: it was redundant once the
  // apex had its own record, and while it was there a plain-http www request was answered at the edge
  // with a redirect to https://www... instead of reaching the Worker, which canonicalises to the apex
  // in a single hop.
  "workers_dev": true,
  "routes": [
    { "pattern": "chatblink.chat", "custom_domain": true },
    { "pattern": "www.chatblink.chat", "custom_domain": true }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatHub"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatblink",
      "database_id": "8bc42a6e-e283-4e7b-998c-f6c654c899c1"
    }
  ],
  // Uploads use Workers KV: free tier, no card required. R2 is the better store
  // (no per-write cost, real object semantics) but activating it asks for a
  // payment method, so to switch later: uncomment r2_buckets, delete kv_namespaces,
  // redeploy - worker/index.js detects either binding automatically.
  "kv_namespaces": [{ "binding": "UPLOADS", "id": "f7d06646751d4cea890dfd53a2d5d3d5" }],
  // "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "chatblink-uploads" }],
  "vars": {
    "PUBLIC_ORIGIN": "https://chatblink.chat",
    // Web Push. The public key is handed to browsers via /api/config so they can subscribe; the
    // matching private key is the Worker secret VAPID_PRIVATE_KEY (see worker/lib/push.js). The
    // subject must be a mailto: or https: URL - push services use it to contact the sender.
    "VAPID_PUBLIC_KEY": "BAX3a-gxqR-JdcIEnAAEUOHCa-vcI_kyUad0603DEK7pzexPv5BJLsxPN7uVL8a24xlMjJhFi-HhWQtIJrZPWPs",
    "VAPID_SUBJECT": "mailto:hello@chatblink.chat"
  },
  "observability": { "enabled": true }
}
