{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatblink",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/index.html",
      "/rooms",
      "/dms",
      "/explore",
      "/room/*",
      "/profile/*",
      "/api/*",
      "/auth/*",
      "/enter",
      "/uploads/*"
    ]
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "ChatHub" }]
  },
  // Declares the apex as a Worker custom domain, so `wrangler deploy` keeps the live domain
  // attached instead of that living only in the dashboard. Requires the zone to be active in this
  // account and no other DNS record on the same name, or the deploy fails.
  // The route is belt-and-braces: a route matches at the edge before the DNS record's origin, so
  // the site keeps working even while a stale proxied record still points somewhere else.
  "workers_dev": true,
  "routes": [
    { "pattern": "chatblink.chat/*", "zone_name": "chatblink.chat" },
    { "pattern": "chatblink.chat", "custom_domain": true }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatHub"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatblink",
      "database_id": "8bc42a6e-e283-4e7b-998c-f6c654c899c1"
    }
  ],
  // Uploads use Workers KV: free tier, no card required. R2 is the better store
  // (no per-write cost, real object semantics) but activating it asks for a
  // payment method, so to switch later: uncomment r2_buckets, delete kv_namespaces,
  // redeploy - worker/index.js detects either binding automatically.
  "kv_namespaces": [{ "binding": "UPLOADS", "id": "f7d06646751d4cea890dfd53a2d5d3d5" }],
  // "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "chatblink-uploads" }],
  "vars": { "PUBLIC_ORIGIN": "https://chatblink.chat" },
  "observability": { "enabled": true }
}
