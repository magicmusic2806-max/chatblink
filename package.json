{
  "name": "chatblink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node server-multi-room.js",
    "dev": "node --watch server-multi-room.js",
    "test": "node tests/auth-e2e.js",
    "dev:worker": "wrangler dev --port 8787",
    "test:worker": "node tests/worker-smoke.js",
    "test:retention": "node tests/message-retention.js",
    "test:canonical": "node --no-warnings tests/canonical-host.js",
    "test:calls": "node tests/call-e2e.js",
    "test:room-design": "node tests/room-design-e2e.js",
    "test:push-gate": "node tests/push-gate-e2e.js",
    "test:theme": "node tests/theme-e2e.js",
    "test:quotas": "node tests/quota-caps.js",
    "test:all": "node tests/run-all.js",
    "test:prod": "node tests/prod-check.js",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute chatblink --local --file=schema.sql",
    "db:remote": "wrangler d1 execute chatblink --remote --file=schema.sql"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "firebase-admin": "^14.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright": "^1.47.0",
    "wrangler": "^4.150.0"
  },
  "engines": {
    "node": ">=20"
  }
}
